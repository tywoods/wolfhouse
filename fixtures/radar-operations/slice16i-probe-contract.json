{
  "schema_version": 1,
  "slice": "RADAR-16I",
  "port": 3036,
  "startup": {
    "type": "Startup",
    "path": "/healthz",
    "initialDelaySeconds": 10,
    "periodSeconds": 10,
    "timeoutSeconds": 5,
    "failureThreshold": 30,
    "successThreshold": 1
  },
  "liveness": {
    "type": "Liveness",
    "path": "/healthz",
    "initialDelaySeconds": 30,
    "periodSeconds": 20,
    "timeoutSeconds": 5,
    "failureThreshold": 3,
    "successThreshold": 1
  },
  "readiness": {
    "type": "Readiness",
    "path": "/readyz",
    "initialDelaySeconds": 5,
    "periodSeconds": 10,
    "timeoutSeconds": 5,
    "failureThreshold": 3,
    "successThreshold": 1
  },
  "bounded_pool": {
    "max": 1,
    "connectionTimeoutMillis": 1500,
    "statement_timeout": 1500,
    "query_timeout": 2000,
    "max_operation_bound_ms": 3500,
    "probe_interval_must_exceed_max_operation_bound": true
  }
}
