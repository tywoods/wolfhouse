{
  "schema_version": 1,
  "slice": "RADAR-16A3",
  "title": "Closed whole attempt-log schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slice",
    "title",
    "method_spec_complete_manifest_sha256",
    "attempts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "slice": {
      "const": "RADAR-16A3"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "method_spec_complete_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "slice",
          "attempt_id",
          "logical_call_id",
          "attempt_index",
          "method_id",
          "http_method",
          "command_or_url",
          "rest_path",
          "api_version",
          "request_body_sha256",
          "subscription_id",
          "resource_group",
          "resource_name",
          "host",
          "started_at_utc",
          "finished_at_utc",
          "outcome",
          "error_class",
          "is_fallback",
          "fallback_step_id",
          "fallback_of_attempt_id",
          "response_artifact_relpath",
          "response_sha256"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "slice": {
            "const": "RADAR-16A3"
          },
          "attempt_id": {
            "type": "string",
            "pattern": "^att-\\d{3}$"
          },
          "logical_call_id": {
            "type": "string",
            "minLength": 1
          },
          "attempt_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "method_id": {
            "type": "string",
            "enum": [
              "arm_account_show",
              "arm_rg_show",
              "arm_resource_list",
              "cost_query",
              "consumption_budgets_list",
              "metric_alerts_list",
              "activity_log_alerts_list",
              "scheduled_query_rules_list",
              "action_groups_list",
              "diagnostic_settings_list",
              "containerapp_env_show",
              "containerapp_show",
              "containerapp_job_show",
              "postgres_flexible_show",
              "law_show",
              "appinsights_show",
              "public_healthz_get"
            ]
          },
          "http_method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD"
            ]
          },
          "command_or_url": {
            "type": "string",
            "minLength": 1
          },
          "rest_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "api_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "request_body_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "subscription_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "resource_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "resource_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "host": {
            "type": [
              "string",
              "null"
            ]
          },
          "started_at_utc": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
          },
          "finished_at_utc": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
          },
          "outcome": {
            "enum": [
              "success",
              "failure",
              "refused_pre_dispatch"
            ]
          },
          "error_class": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_fallback": {
            "type": "boolean"
          },
          "fallback_step_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "fallback_of_attempt_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^att-\\d{3}$"
          },
          "response_artifact_relpath": {
            "type": [
              "string",
              "null"
            ]
          },
          "response_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "success"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "properties": {
                "error_class": {
                  "type": "null"
                },
                "response_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "response_artifact_relpath": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "failure"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "properties": {
                "error_class": {
                  "type": "string",
                  "minLength": 1
                },
                "response_sha256": {
                  "type": "null"
                },
                "response_artifact_relpath": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "refused_pre_dispatch"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "properties": {
                "error_class": {
                  "type": "string",
                  "minLength": 1
                },
                "response_sha256": {
                  "type": "null"
                },
                "response_artifact_relpath": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  },
  "verifier_enforced_whole_log_rules": {
    "attempt_ids_unique": true,
    "attempt_ids_contiguous_ordered_from_att_001": true,
    "one_row_per_physical_dispatch": true,
    "attempt_index_contiguous_per_logical_call_from_0": true,
    "retryable_error_classes_exact_match_method_policy": true,
    "fallback_chain_exact_match_method_policy": true,
    "bounded_by_method_max_physical_attempts": true,
    "outcome_conditional_error_response_hash_fields": true,
    "additionalProperties": false
  }
}
