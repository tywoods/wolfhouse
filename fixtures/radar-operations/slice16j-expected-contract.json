  "master_basis": "d9d297e8d28b499316fdcb89ff7954ebb4cdae06",
  "branch": "radar/slice-16j-request-correlation",
  "live_deploy": false,
  "live_mutation": false,
  "title": "Staff API request correlation at HTTP boundary — source partial only; supersedes deferred 16D",
  "supersedes": {
    "outcome_id": "16D_staff_api_request_correlation",
    "branch": "radar/slice-16d-staff-request-correlation",
    "tip_sha": "4478ac2ad65d385e4bbf577ebe77c5c80ad028e4",
    "policy": "do_not_merge_do_not_modify"
  },
  "event_context_contract": {
    "header": "X-Request-Id",
    "header_accept": {
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "canonical": "uuid_v4",
      "normalize": "lowercase",
      "on_reject": "crypto.randomUUID",
      "reject_array_duplicate_ambiguous": true,
      "reject_oversize_non_uuid": true
    },
    "header_set_before_route_handling": true,
    "propagation": "AsyncLocalStorage",
    "downstream_accessors": ["getRequestContext", "requestId"],
    "handler_signatures_unchanged": true,
    "route": "normalized_template_or_pathname_without_query",
    "tenant_slug_rule": "trusted_ingress_binding_at_construction_else_omit",
    "completion_sink": "synchronous_process_logger_console_only",
    "completion_ownership": {
      "async_log_queue": false,
      "signal_shutdown_handlers": false,
      "exit_code_mutation": false,
      "flush_delivery_guarantee": false
    },
    "duration_ms": {
      "bucket_ms": 5,
      "rounding": "ceil_bound"
    },
    "completion_event": {
      "event": "staff_api_http_request_complete",
      "at_most_once": true,
      "completion_triggers": ["finish", "close", "request_error", "response_error"],
      "fields": [
        "event",
        "request_id",
        "tenant_slug",
        "method",
        "route",
        "status",
        "duration_ms"
      ],
      "tenant_slug": "omit_unless_trusted_ingress_binding_present",
      "must_not_include": [
        "url_query",
        "headers",
        "body",
        "phone",
        "email",
        "name",
        "tokens",
        "stack",
        "error_text"
      ]
    },
    "preserves": [
      "existing_response_bodies",
      "existing_error_behavior",
      "streaming_no_body_buffer",
      "original_process_response_semantics"
    ]
  },
  "still_open": [
    "Live deploy of Staff API image with correlation middleware",
    "Log Analytics / App Insights delivery + search proof of completion events",
    "Retention policy for correlation completion records",
    "End-to-end Meta → Hermes → Staff API → Stripe correlation drill"
  ],
  "final_controlled_drill": {
    "id": "16J_DRILL_correlation_log_query",
    "status": "open",
    "pass_rule": "After approved deploy: known X-Request-Id traffic; prove one completion event per request in LAW/App Insights with route (not raw URL/query) and no secret/guest leakage; prove concurrent requests do not bleed context"
  },
  "artifacts": [
    "scripts/lib/staff-api-request-correlation.js",
    "scripts/staff-query-api.js",
    "scripts/lib/radar-slice16j-staff-request-correlation.js",
    "scripts/verify-radar-slice16j-staff-request-correlation.js",
    "fixtures/radar-operations/slice16j-expected-contract.json"
  ],
  "gates": [
    "npm run verify:radar-slice16j-staff-request-correlation",
    "npm run verify:radar-slice16a-operations-gate-ledger",
    "npm run verify:radar-slice16b-staging-cost-budgets",
