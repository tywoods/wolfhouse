  "event_schema": {
    "event": "staff_api_readiness_shutdown_completion",
    "fields_only": [
      "event",
      "original_signal",
      "pool_close_result",
      "server_close_result",
      "failure_classes",
      "completion"
    ],
    "original_signal": ["SIGTERM", "SIGINT"],
    "pool_close_result": ["ok", "rejected", "timeout", "throw"],
    "server_close_result": ["ok", "rejected", "timeout", "throw", "already_closed"],
    "failure_classes": "bounded_16W_enum_subset_array",
    "completion": true
  },
  "emission_contract": {
    "boundary": "runStaffApiReadinessShutdown",
    "timing": "after_bounded_pool_and_server_results_before_detach_and_native_re_signal",
    "exactly_one_record_per_shutdown": true,
    "same_repeated_mixed_signals": "exactly_one",
    "default_logger": "one_json_line_stdout",
    "injected_logger": "supported_non_throwing_path",
    "logger_throw_must_not_block_detach_or_terminate": true,
    "terminate_throw_no_duplicate": true
  },
  "exclusions": [
    "pid",
    "secrets",
    "tokens",
    "urls",
    "error_messages",
    "stacks",
    "timing_guesses",
    "dsn",
    "connection_strings"
  ],
  "preserves": [
    "16W_shutdown_semantics",
    "readyz_sql",
    "readyz_body",
    "aca_probes",
    "shared_tenant_runtime",
    "g02_partial"
  ],
  "tenant_scope": {
    "wolfhouse_staging_image": "shared_staff_api_runtime",
    "sunset_staging_image": "shared_staff_api_runtime",
    "note": "Both ACA apps run the same Staff API image; completion log is tenant-agnostic at source"
  },
  "still_open": [
    "SIGTERM/SIGINT closeReadinessPool live lifecycle behavior on deployed revision",
    "Serving-revision /readyz=503 body path",
    "Raising G02 verdict to proven"
  ],
  "final_controlled_drill": {
    "id": "16Y_DRILL_live_sigterm_completion_log_evidence",
