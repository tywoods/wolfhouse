  "title": "Staff API dependency-aware readiness (/readyz + ACA probes) — source partial only; supersedes deferred 16C",
  "supersedes": {
    "outcome_id": "16C_staff_api_readiness_dependencies",
    "branch": "radar/slice-16c-staff-api-readiness",
