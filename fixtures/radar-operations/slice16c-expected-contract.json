  "live_mutation": false,
  "title": "Staff API dependency-aware readiness (/readyz + ACA probes) — source partial only",
  "endpoint_contract": {
    "liveness": {
      "path": "/healthz",
      "depends_on_postgres": false,
      "success": { "http_status": 200, "body_status": "ok" }
    },
    "readiness": {
      "path": "/readyz",
      "depends_on_postgres": true,
      "check": "bounded_readonly_select_1_via_dedicated_max1_readiness_pool",
      "sql": "SELECT 1",
      "timeout_ms": 2500,
      "success": { "http_status": 200, "body": { "status": "ready" } },
      "failure": { "http_status": 503, "body": { "status": "not-ready" } },
      "must_not_expose": ["credentials", "sql", "stack", "upstream_error_message"]
    }
  },
  "probe_contract": {
    "port": 3036,
    "startup": {
      "type": "Startup",
      "path": "/healthz",
      "initialDelaySeconds": 10,
      "periodSeconds": 10,
      "timeoutSeconds": 5,
      "failureThreshold": 30,
      "successThreshold": 1
    },
    "liveness": {
      "type": "Liveness",
      "path": "/healthz",
      "initialDelaySeconds": 30,
      "periodSeconds": 20,
      "timeoutSeconds": 5,
      "failureThreshold": 3,
      "successThreshold": 1
    },
    "readiness": {
      "type": "Readiness",
      "path": "/readyz",
      "initialDelaySeconds": 5,
      "periodSeconds": 10,
      "timeoutSeconds": 5,
      "failureThreshold": 3,
      "successThreshold": 1
    },
    "semantics": {
      "readiness_failure": "removes_traffic_without_restart",
      "liveness_failure": "restarts_container",
      "liveness_must_not_depend_on_postgres": true,
      "startup_must_not_depend_on_postgres": true
    }
  },
  "still_open": [
    "Live deploy of Staff API image + ACA probe template to Wolfhouse and Sunset staging",
