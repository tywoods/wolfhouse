{
  "apps": {
    "http": {
      "servers": {
        "staging": {
          "routes": [
            {
              "match": [{ "path": ["/whatsapp/webhook"] }],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [{ "dial": "127.0.0.1:8094" }]
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
