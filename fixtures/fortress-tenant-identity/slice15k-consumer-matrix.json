  "control_chain_b01": [
    {
      "step": 1,
      "id": "C_META_READ_RAW_BODY",
      "owner": "scripts/staff-query-api.js",
      "symbol": "handleMetaWhatsAppWebhookPost → readBodyRaw",
      "behavior": "Read up to 262144 raw bytes before JSON.parse",
      "side_effect_before_admit": "none",
      "verdict": "proven_fail_closed"
    },
    {
      "step": 2,
      "id": "C_META_RESOLVE_APP_SECRET",
      "owner": "scripts/lib/luna-meta-whatsapp-webhook.js",
      "symbol": "resolveMetaAppSecret",
