      "side_effect_before_admit": "none",
      "verdict": "proven_fail_closed"
    },
    {
      "step": 3,
      "id": "C_META_VERIFY_HMAC",
      "owner": "scripts/lib/luna-meta-whatsapp-webhook.js",
      "symbol": "verifyMetaHubSignature256",
      "behavior": "Absent secret → skipped:true. Missing header → skipped:true. Bad format/mismatch → skipped:false verified:false. Match → verified:true.",
      "side_effect_before_admit": "none",
      "verdict": "vulnerable"
    },
    {
      "step": 4,
      "id": "C_META_HTTP_ADMIT_GATE",
      "owner": "scripts/staff-query-api.js",
      "symbol": "handleMetaWhatsAppWebhookPost",
      "behavior": "Reject only when !skipped && !verified. skipped:true continues to JSON.parse + PostEntry.",
      "side_effect_before_admit": "none on reject; on admit may acquire PG via PostEntry",
      "verdict": "vulnerable"
    },
    {
      "step": 5,
      "id": "C_META_POST_ENTRY",
      "owner": "scripts/lib/luna-meta-whatsapp-inbound-process.js",
      "symbol": "processMetaWhatsAppWebhookPostEntry",
      "behavior": "Normalize + authority + optional withPgClient claim/draft after signature admit",
      "side_effect_before_admit": "n/a (post-admit)",
      "verdict": "n/a_post_admit"
    },
    {
      "step": 6,
      "id": "C_META_HUB_GET",
      "owner": "scripts/lib/luna-meta-whatsapp-webhook.js",
      "symbol": "verifyMetaHubChallenge / resolveMetaWhatsAppVerifyToken",
      "behavior": "Compare hub.verify_token to env META_WHATSAPP_VERIFY_TOKEN or DEFAULT_META_WHATSAPP_VERIFY_TOKEN",
      "side_effect_before_admit": "none",
      "verdict": "vulnerable"
    },
    {
      "step": 7,
      "id": "C_META_ROUTE",
      "owner": "scripts/staff-query-api.js",
      "symbol": "router pathname === /staff/meta/whatsapp/webhook",
      "behavior": "Public GET/POST; no session auth; path-exact before catch-all",
      "side_effect_before_admit": "none",
      "verdict": "proven_fail_closed"
    }
  ],
  "control_chain_b12": [
    {
      "step": 1,
      "id": "C_STRIPE_READ_RAW_BODY",
      "owner": "scripts/staff-query-api.js",
      "symbol": "handleStripeWebhook → readBodyRaw",
