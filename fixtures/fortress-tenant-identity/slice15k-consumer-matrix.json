{
  "schema_version": 1,
  "slice": "FORTRESS-15K",
  "outcome_id": "15K_signature_control_reaudit",
  "description": "Source/config consumer matrix for B01 Meta signature/hub verify and B12 Stripe webhook signature. Fake IDs only. Distinguishes committed source guarantees from live activation.",
  "boundary_rollup": {
    "B01_meta_whatsapp_signature_ingress": "vulnerable",
    "B12_stripe_webhook_signature": "proven_isolated_by_runtime"
