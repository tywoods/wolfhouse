      "verdict": "proven_fail_closed"
    },
    {
      "step": 4,
      "id": "C_STRIPE_CONSTRUCT_EVENT",
      "owner": "scripts/staff-query-api.js",
      "symbol": "stripe.webhooks.constructEvent",
      "behavior": "HMAC verify raw body + stripe-signature + webhook secret; failure → 400",
