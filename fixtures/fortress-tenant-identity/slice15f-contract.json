  "api": {
    "resolveStaffBotRequestEffectiveTenant": {
      "signature": "resolveStaffBotRequestEffectiveTenant({ authMode, user, body, query, forceTenantSlug })",
      "bot_token": {
        "effective": "principal.client_slug",
        "omission": "allowed (principal supplies tenant)",
        "empty_alias": "fail closed empty_request_tenant_alias",
        "conflict": "fail closed request_tenant_conflict before handler",
        "no_hardcoded_default": true
      },
      "force_tenant": "path-forced effective; body cannot select",
      "session": "request alias or session principal; ACL assert left to handlers; DEFAULT defer when unbound",
      "open": "request alias or defer"
    },
    "dispatchStaffBotRouteWithPrincipalRequestTenant": {
      "behavior": "resolve → deny before handler on conflict/empty → pin effective → 15E ACL gate for bot_token only"
    },
    "dispatchBotRouteBoundToPrincipalTenant": {
      "http_wrapper": "staff-query-api.js — reads cached body, 403 client_access_denied on deny"
    }
  },
