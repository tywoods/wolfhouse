      "color": "GREEN",
      "boundary_ids": ["B03_client_channel_resolver", "B10_db_tenant_scope_predicates"],
      "attack": "clients.json location_id globally unique (no Wolfhouse/Sunset collision)",
      "input": {
        "classifier": "registry_location_unique"
      },
      "expect": {
        "unique": true,
