    {
      "id": "AC_HEADER_BODY_QUERY_CONFLICT_MODEL",
      "color": "RED",
      "boundary_ids": ["B07_staff_bot_body_client_slug"],
      "attack": "model conflicting tenant fields: header runtime vs body vs query defaults",
      "input": {
        "classifier": "conflict_fields",
        "header_runtime_client_slug": "sunset",
        "body_client_slug": "wolfhouse-somo",
        "query_client": "mirleft",
