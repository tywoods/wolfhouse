---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Pain from '../components/sections/Pain.astro';
import DemoSection from '../components/DemoSection.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Capabilities from '../components/sections/Capabilities.astro';
import NotAChatbot from '../components/sections/NotAChatbot.astro';
import WhoItsFor from '../components/sections/WhoItsFor.astro';
import StaffPortal from '../components/sections/StaffPortal.astro';
import Trust from '../components/sections/Trust.astro';
import Onboarding from '../components/sections/Onboarding.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import LeadForm from '../components/sections/LeadForm.astro';
import Footer from '../components/Footer.astro';
---
<Layout path="/">
  <Header slot="header" />

  <Hero />
  <Pain />
  <DemoSection />
  <HowItWorks />
  <Capabilities />
  <NotAChatbot />
  <WhoItsFor />
  <StaffPortal />
  <Trust />
  <Onboarding />
  <FinalCta />
  <LeadForm />

  <Footer slot="footer" />
</Layout>
