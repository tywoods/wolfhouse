---
// Onboarding — 5-step process in a stepped/timeline layout.
// Light section (sand canvas). Honest, sequential, no fluff.

const steps = [
  {
    n: '01',
    title: 'Understand your business',
    body: 'We start with a structured conversation about how your business actually runs — what you sell, how you price it, how guests find you, and what your team finds most repetitive. No assumptions, no templates.',
    accent: 'terracotta',
  },
  {
    n: '02',
    title: 'Configure services, prices, rules & tone',
    body: 'Your packages, availability logic, pricing rules, and operational policies are set up explicitly in the Luna config. We also calibrate the bot\'s tone — warm, concise, formal, whatever fits your brand.',
    accent: 'seaglass',
  },
  {
    n: '03',
    title: 'Connect approved systems & WhatsApp',
    body: 'We wire up your WhatsApp Business number and any approved integrations — booking systems, availability calendars, payment tooling. Each connection is scoped and reviewed before it goes live.',
    accent: 'moon',
  },
  {
    n: '04',
    title: 'Test realistic conversations',
    body: 'Before any guest sees Luna, we run it through real-world scenarios — edge cases, unusual requests, pricing questions, handoff triggers. Your team signs off when it behaves correctly.',
    accent: 'terracotta',
  },
  {
    n: '05',
    title: 'Launch with monitoring and improve from real feedback',
    body: 'Go live with full visibility in the staff portal. We review real conversation logs with you in the first weeks, catch gaps in configuration, and iterate. Luna improves from what your actual guests ask.',
    accent: 'seaglass',
  },
] as const;
---

<section class="section onboarding">
  <div class="container">
    <div class="onboarding__intro" data-animate>
      <p class="eyebrow">Getting started</p>
      <h2 class="onboarding__heading">From first call to first guest — in five steps.</h2>
      <p class="lead">
        We do the configuration work with you. You should be able to see Luna handling real
        enquiries before you commit to anything.
      </p>
    </div>

    <ol class="onboarding__steps" data-animate>
      {steps.map((s) => (
        <li class="onboarding__step">
          <div class="onboarding__step-left">
            <span class:list={['onboarding__step-num', `onboarding__step-num--${s.accent}`]}>
              {s.n}
            </span>
            <span class="onboarding__step-line" aria-hidden="true"></span>
          </div>
          <div class="onboarding__step-body">
            <h3 class="onboarding__step-title">{s.title}</h3>
            <p class="onboarding__step-text">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="onboarding__cta" data-animate>
      <p class="onboarding__cta-line">Ready to see if Luna fits your business?</p>
      <a href="#lead" class="btn btn--primary">Talk to us about your setup</a>
      <a href="#demo" class="btn btn--ghost">Try the interactive demo</a>
    </div>
  </div>
</section>

<style>
  .onboarding { background: var(--sand-100); }

  .onboarding__intro { max-width: 58ch; margin-bottom: var(--space-2xl); }
  .onboarding__intro .eyebrow { margin-bottom: var(--space-xs); }
  .onboarding__heading { font-size: var(--step-4); margin-top: var(--space-xs); margin-bottom: var(--space-m); }

  /* Step list */
  .onboarding__steps {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .onboarding__step {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-m);
    align-items: stretch;
  }

  /* Left column: number + connecting line */
  .onboarding__step-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .onboarding__step-num {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    color: #1a1206;
    background: var(--step-accent, var(--terracotta-500));
    border: 2px solid color-mix(in srgb, var(--step-accent, var(--terracotta-500)) 60%, transparent);
    flex-shrink: 0;
    letter-spacing: 0.02em;
    box-shadow: var(--shadow-s);
  }

  /* Accent via classes (no inline style attrs — CSP style-src without unsafe-inline). */
  .onboarding__step-num--terracotta { --step-accent: var(--terracotta-500); }
  .onboarding__step-num--seaglass { --step-accent: var(--seaglass-500); }
  .onboarding__step-num--moon { --step-accent: var(--moon-300); }

  .onboarding__step-line {
    flex: 1;
    width: 2px;
    background: var(--sand-200);
    border-radius: 1px;
    margin-block: var(--space-2xs);
  }

  /* Hide the line on the last step */
  .onboarding__step:last-child .onboarding__step-line { display: none; }

  /* Right column: content */
  .onboarding__step-body {
    padding-bottom: var(--space-xl);
    padding-top: var(--space-2xs);
  }

  .onboarding__step:last-child .onboarding__step-body { padding-bottom: 0; }

  .onboarding__step-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 550;
    color: var(--ink-900);
    margin-bottom: var(--space-xs);
    line-height: 1.2;
  }

  .onboarding__step-text {
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 58ch;
  }

  /* CTA strip */
  .onboarding__cta {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--sand-200);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
  }

  .onboarding__cta-line {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 550;
    color: var(--ink-900);
    flex: 1;
    min-width: 240px;
  }

  @media (max-width: 560px) {
    .onboarding__step { grid-template-columns: 44px 1fr; gap: var(--space-s); }
    .onboarding__step-num { width: 36px; height: 36px; font-size: 0.72rem; }
    .onboarding__cta { flex-direction: column; align-items: flex-start; }
    .onboarding__cta-line { min-width: unset; }
  }
</style>
