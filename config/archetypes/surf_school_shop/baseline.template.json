{
  "_meta": {
    "status": "archetype_template",
    "version": "1B.0",
    "purpose": "FACTORY 1B static surf_school_shop archetype template derived from Sunset multi-location school+shop shape. Placeholders only. Not a live client.",
    "client_slug": "{{CLIENT_SLUG}}",
    "client_name": "{{CLIENT_NAME}}",
    "tenant_id": "{{CLIENT_SLUG}}",
    "vertical": "surf_school_rentals",
    "timezone": "{{TIMEZONE}}",
    "languages": ["{{LANGUAGE_PRIMARY}}", "{{LANGUAGE_SECONDARY}}"],
    "currency": "{{CURRENCY}}",
    "based_on_schema": "config/clients/sunset.baseline.json",
    "slice": "FACTORY-1B"
  },
  "live_enabled": false,
  "locations": [
    {
      "location_id": "{{LOCATION_ID_1}}",
      "display_name": "{{LOCATION_NAME_1}}"
    },
    {
      "location_id": "{{LOCATION_ID_2}}",
      "display_name": "{{LOCATION_NAME_2}}"
    }
  ],
  "deployment": {
    "enabled": false,
    "deploy_target": null,
    "whatsapp_phone_number_id": null,
    "email_inbox": null,
    "staff_api_tenant_scope": "{{CLIENT_SLUG}}",
    "stripe_context_ref": "secret:stripe_publishable_key"
  },
  "secrets": {
    "_note": "Real credentials must never be committed. Generator (1C+) may only emit secret:<key> refs plus a secrets.example file.",
    "secret_file": "config/clients/{{CLIENT_SLUG}}.secrets.json",
    "example_file": "config/archetypes/surf_school_shop/secrets.example.template.json",
    "keys": [
      "handoff_whatsapp_phone",
      "handoff_email_address",
      "master_admin_numbers",
      "staff_admin_password",
      "stripe_publishable_key",
      "stripe_secret_key",
      "stripe_webhook_secret"
    ]
  },
  "persona": {
    "assistant_name": "{{ASSISTANT_NAME}}",
    "brand_name": "{{BRAND_NAME}}",
    "role": "{{PERSONA_ROLE}}",
    "voice_summary": "{{VOICE_SUMMARY}}",
    "no_ai_mention": true,
    "one_clear_next_step": true,
    "emoji_level": "{{EMOJI_LEVEL}}"
  },
  "channels": {
    "whatsapp": {
      "status": "template",
      "enabled": false,
      "reply_style": "short_one_question_per_reply",
      "max_reply_chars": 900
    },
    "email": {
      "status": "planned",
      "enabled": false,
      "reply_style": "structured_sections_allowed"
    }
  },
  "features": {
    "portal_default_tab": "portal-home",
    "inventory_model": "lessons_capacity_plus_rentals_unlimited",
    "supports_multi_location": true,
    "supports_rentals": true,
    "supports_lessons": true
  },
  "pricing_policy": {
    "currency": "{{CURRENCY}}",
    "live_autonomous_charge_requires": "pricing_status_confirmed",
    "on_unverified_seed_in_live": "block_do_not_quote",
    "on_provisional_in_live": "handoff_or_block_do_not_autocharge",
    "rounding_rule_addons": "round_up_to_nearest_1_eur",
    "payment_claim_behavior": "check_stripe_payment_events_not_llm"
  },
  "catalog": {
    "offering_type": "multi",
    "price_quote_safe_default": "no_price_quote_without_pricing_status_confirmed_config_row",
    "rentals": {
      "inventory_model": "unlimited",
      "price_basis": "per_item_per_window",
      "windows": [
        "{{RENTAL_WINDOW_1}}",
        "{{RENTAL_WINDOW_2}}",
        "{{RENTAL_WINDOW_3}}"
      ],
      "offerings": {
        "{{RENTAL_BOARD}}": {
          "label": "{{RENTAL_BOARD_LABEL}}",
          "inventory_model": "unlimited",
          "pricing_status": "unverified_seed",
          "prices_eur": {
            "{{RENTAL_WINDOW_1}}": "{{PRICE_EUR_PLACEHOLDER}}",
            "{{RENTAL_WINDOW_2}}": "{{PRICE_EUR_PLACEHOLDER}}",
            "{{RENTAL_WINDOW_3}}": "{{PRICE_EUR_PLACEHOLDER}}"
          }
        },
        "{{RENTAL_WETSUIT}}": {
          "label": "{{RENTAL_WETSUIT_LABEL}}",
          "inventory_model": "unlimited",
          "pricing_status": "unverified_seed",
          "prices_eur": {
            "{{RENTAL_WINDOW_1}}": "{{PRICE_EUR_PLACEHOLDER}}",
            "{{RENTAL_WINDOW_2}}": "{{PRICE_EUR_PLACEHOLDER}}",
            "{{RENTAL_WINDOW_3}}": "{{PRICE_EUR_PLACEHOLDER}}"
          }
        },
        "{{RENTAL_BUNDLE}}": {
          "label": "{{RENTAL_BUNDLE_LABEL}}",
          "inventory_model": "unlimited",
          "pricing_status": "unverified_seed",
          "prices_eur": {
            "{{RENTAL_WINDOW_1}}": "{{PRICE_EUR_PLACEHOLDER}}",
            "{{RENTAL_WINDOW_2}}": "{{PRICE_EUR_PLACEHOLDER}}",
            "{{RENTAL_WINDOW_3}}": "{{PRICE_EUR_PLACEHOLDER}}"
          }
        }
      },
      "safe_default": "no_price_quote_without_confirmed_config_row_no_availability_check_for_unlimited_mvp"
    },
    "lessons": {
      "inventory_model": "capacity_limited",
      "capacity_check_source": "staff_api_slot_capacity",
      "fallback_if_no_capacity_data": "collect_request_then_staff_schedule",
      "price_basis": "per_seat_per_session",
      "materials_included": true,
      "scheduling": {
        "common_slot_times": ["{{LESSON_SLOT_1}}", "{{LESSON_SLOT_2}}"],
        "arrive_before_class_minutes": "{{ARRIVE_BEFORE_MINUTES}}",
        "bot_assigns_slot": false,
        "bot_collects_request_then_staff_schedule": true
      },
      "offerings": {
        "{{LESSON_GROUP_ADULT}}": {
          "label": "{{LESSON_GROUP_ADULT_LABEL}}",
          "inventory_model": "capacity_limited",
          "price_basis": "per_seat_per_session",
          "pricing_status": "unverified_seed",
          "prices_eur": {
            "single_lesson": "{{PRICE_EUR_PLACEHOLDER}}",
            "pack_per_surfer": "{{PRICE_EUR_PLACEHOLDER}}"
          }
        },
        "{{LESSON_KIDS}}": {
          "label": "{{LESSON_KIDS_LABEL}}",
          "inventory_model": "capacity_limited",
          "price_basis": "per_seat_per_session",
          "pricing_status": "unverified_seed",
          "prices_eur": {
            "single_lesson": "{{PRICE_EUR_PLACEHOLDER}}"
          }
        },
        "{{LESSON_PRIVATE}}": {
          "label": "{{LESSON_PRIVATE_LABEL}}",
          "inventory_model": "capacity_limited",
          "price_basis": "per_session",
          "pricing_status": "unverified_seed",
          "prices_eur": {
            "per_session": "{{PRICE_EUR_PLACEHOLDER}}"
          }
        }
      },
      "safe_default": "no_lesson_seat_without_capacity_check_or_staff_schedule_confirmation"
    },
    "accommodation": {
      "inventory_model": "partner_confirmed",
      "inventory_owner": "partner_hotel",
      "availability_source": "staff_api_or_partner_confirmation",
      "price_basis": "per_package_quote",
      "pricing_status": "unverified_seed",
      "offerings": {
        "{{ACCOMMODATION_PACKAGE}}": {
          "label": "{{ACCOMMODATION_PACKAGE_LABEL}}",
          "inventory_model": "partner_confirmed",
          "includes": ["{{ACCOMMODATION_INCLUDE_1}}", "{{ACCOMMODATION_INCLUDE_2}}"],
          "pricing_status": "unverified_seed"
        }
      },
      "safe_default": "never_confirm_accommodation_without_partner_or_staff_api_confirmation"
    }
  },
  "service_addons": {
    "lesson_scheduling": {
      "enabled": false,
      "inventory_model": "capacity_limited",
      "tracking": "staff_api_slots",
      "bot_checks_slot_availability": true,
      "bot_assigns_slot": false,
      "bot_collects_request_then_staff_schedule": false,
      "daily_slots": []
    }
  },
  "payment": {
    "payment_link_auto_allowed": false,
    "deposit_rule": {
      "type": "{{DEPOSIT_RULE_TYPE}}",
      "scope": "{{DEPOSIT_RULE_SCOPE}}",
      "default_eur": "{{DEPOSIT_DEFAULT_EUR}}",
      "pricing_status": "unverified_seed"
    },
    "hold_expiry_minutes": "{{HOLD_EXPIRY_MINUTES}}",
    "payment_link_options": ["full"],
    "balance_payment_methods": ["{{BALANCE_METHOD_1}}"],
    "payment_link_requires_name": true,
    "payment_link_requires_email": true,
    "payment_claim_behavior": "check_stripe_payment_events_not_llm",
    "safe_default": "do_not_send_payment_link_while_template_disabled"
  },
  "confirmation": {
    "confirmation_send_mode": "dry_run",
    "confirmation_requires_payment_truth": true,
    "include_service_details": true,
    "include_meeting_point": true,
    "include_arrive_before_minutes": "{{ARRIVE_BEFORE_MINUTES}}",
    "safe_default": "keep_dry_run_until_real_send_gate_is_proven"
  },
  "cancellation": {
    "auto_cancel_allowed_if_unpaid": true,
    "paid_cancellation_handoff": true,
    "refund_requests_handoff": true,
    "refund_policy": "{{REFUND_POLICY}}",
    "refund_mechanism": {
      "default_remedy": "{{REFUND_DEFAULT_REMEDY}}",
      "all_refunds_manual_staff": true,
      "bot_issues_refund_or_voucher": false
    },
    "bad_weather_or_no_waves_policy": "{{BAD_WEATHER_POLICY}}",
    "no_show_policy": "{{NO_SHOW_POLICY}}"
  },
  "handoff": {
    "handoff_channel": "whatsapp",
    "handoff_whatsapp_target": {
      "label": "{{HANDOFF_LABEL}}",
      "phone_ref": "secret:handoff_whatsapp_phone",
      "editable": true
    },
    "tell_guest_before_handoff": true,
    "handoff_safe_reply": "{{HANDOFF_SAFE_REPLY}}",
    "always_handoff": [
      "refund_request",
      "complaint_or_angry_guest",
      "discount_request",
      "large_group_beyond_configured_limit",
      "minor_without_guardian_consent",
      "guest_claims_paid_but_no_payment_record",
      "paid_booking_cancellation",
      "accommodation_availability_unconfirmed",
      "medical_legal_emergency",
      "low_route_confidence",
      "llm_parse_error_or_api_failure"
    ]
  },
  "llm_safety": {
    "low_confidence_behavior": "handoff",
    "api_error_behavior": "handoff_or_logged_safe_fallback",
    "parsing_uncertainty_behavior": "ask_clarification_not_act",
    "never_mark_from_llm_alone": ["paid", "confirmed", "cancelled"],
    "multilingual_test_required": ["{{LANGUAGE_PRIMARY}}", "{{LANGUAGE_SECONDARY}}"]
  },
  "safety_rules": {
    "no_invented_prices": true,
    "no_invented_availability": true,
    "no_invented_payment_links": true,
    "confirmation_requires_payment_truth": true,
    "minor_guardian_consent_required_before_booking": true
  },
  "customer_memory_privacy": "engine_default_blocked_until_privacy_gate",
  "staff_directory": {
    "default_for_unknown_number": "treat_as_guest_no_staff_privileges",
    "master_admin": {
      "numbers_ref": "secret:master_admin_numbers",
      "default_permissions": {
        "can_query": true,
        "can_reply_handoff": true,
        "can_manage_staff": true
      }
    },
    "approved_numbers": []
  },
  "staff_queries": {
    "read_only": true,
    "staff_channel_only": true,
    "safe_intents": [
      "bookings_on_date",
      "lessons_on_date",
      "rentals_active_on_date",
      "balance_outstanding"
    ]
  },
  "portal_demo": {
    "demo_mode": false,
    "tenant_id": "{{CLIENT_SLUG}}",
    "client_slug": "{{CLIENT_SLUG}}",
    "lesson_slots": [],
    "inbox_threads": []
  }
}
