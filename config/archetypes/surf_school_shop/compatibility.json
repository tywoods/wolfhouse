{
  "archetype_id": "surf_school_shop",
  "reference_client_slug": "sunset",
  "reference_location_ids": ["sunset-somo", "sunset-sardinero"],
  "legacy_vertical": "surf_school_rentals",
  "portal_default_tab": "portal-home",
  "registry_shape": {
    "client_slug_placeholder": "{{CLIENT_SLUG}}",
    "live_enabled": false,
    "location_id_placeholders": ["{{LOCATION_ID_1}}", "{{LOCATION_ID_2}}"],
    "location_cardinality": "multi_location"
  },
  "field_mappings": {
    "pricing": {
      "baseline_path": "catalog.rentals.offerings",
      "lessons_path": "catalog.lessons.offerings",
      "consumers": [
        "scripts/lib/tenant-business-config.js",
        "scripts/lib/sunset-rental-price-lookup.js",
        "scripts/lib/sunset-course-lesson-price-lookup.js",
        "scripts/lib/sunset-group-lesson-quote.js",
        "scripts/lib/sunset-admin-price-resolve.js",
        "scripts/lib/sunset-admin-price-sync.js"
      ]
    },
    "services": {
      "baseline_path": "catalog",
      "service_addons_path": "service_addons",
      "consumers": [
        "scripts/lib/sunset-catalog-tool-executor.js",
        "scripts/lib/luna-front-desk-catalog-service.js",
        "scripts/lib/sunset-luna-school-context.js"
      ]
    },
    "schedule": {
      "baseline_path": "catalog.lessons.scheduling",
      "service_addons_path": "service_addons.lesson_scheduling",
      "consumers": [
        "scripts/lib/tenant-business-config.js",
        "scripts/lib/sunset-schedule-booking-drawer.js",
        "scripts/lib/sunset-schedule-booking-writes.js"
      ]
    },
    "profile": {
      "baseline_path": "persona",
      "meta_path": "_meta",
      "consumers": [
        "scripts/lib/staff-portal-clients.js",
        "scripts/lib/tenant-business-config.js"
      ]
    },
    "features": {
      "portal_default_tab": "portal-home",
      "inventory_model": "lessons_capacity_plus_rentals_unlimited",
      "hidden_tabs": ["bed-calendar", "tour-operator"],
      "consumers": [
        "scripts/lib/staff-portal-clients.js"
      ]
    },
    "locations": {
      "baseline_path": "locations",
      "consumers": [
        "scripts/lib/sunset-admin-location-store.js",
        "scripts/lib/tenant-business-config.js",
        "scripts/lib/staff-portal-clients.js"
      ]
    }
  },
  "consumer_categories": [
    "pricing_services_schedule_profile_consumers",
    "physical_site_keys",
    "registries"
  ],
  "legacy_compatibility": {
    "loads_via_existing_baseline_without_factory_migration": true,
    "factory_templates_are_not_runtime_loaded": true,
    "reference_pair_bytes_must_remain_unchanged": [
      "config/clients/sunset.baseline.json"
    ]
  }
}
