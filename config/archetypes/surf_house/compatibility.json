{
  "archetype_id": "surf_house",
  "reference_client_slug": "wolfhouse",
  "reference_location_ids": ["wolfhouse-somo"],
  "legacy_vertical": "lodging_surf_house",
  "portal_default_tab": "bed-calendar",
  "registry_shape": {
    "client_slug_placeholder": "{{CLIENT_SLUG}}",
    "live_enabled": false,
    "location_id_placeholders": ["{{LOCATION_ID}}"],
    "location_cardinality": "single_primary"
  },
  "field_mappings": {
    "pricing": {
      "baseline_path": "packages",
      "companion_file": "pricing.template.json",
      "consumption_class": "mixed",
      "calculator_consumed_fields": [
        "seasons",
        "packages",
        "room_supplements",
        "add_ons",
        "deposits",
        "payment_options",
        "currency",
        "client_slug"
      ],
      "companion_metadata_not_calculator_consumed": ["rounding", "hold"],
      "legacy_consumers": [
        "scripts/lib/wolfhouse-quote-calculator.js",
        "scripts/lib/luna-booking-addons-policy.js",
        "scripts/lib/luna-booking-reactive-services-policy.js",
        "scripts/lib/guest-addon-combo-rebalance-db.js",
        "scripts/lib/luna-guest-booking-dry-run.js",
        "scripts/staff-query-api.js"
      ],
      "note": "rounding/hold are recognized companion metadata for canonical-file parity; wolfhouse-quote-calculator does not read them."
    },
    "services": {
      "baseline_path": "service_addons.service_catalog",
      "bundles_path": "service_addons.bundles",
      "consumption_class": "legacy_consumed",
      "legacy_consumers": [
        "scripts/lib/luna-booking-addons-policy.js",
        "scripts/lib/luna-booking-reactive-services-policy.js",
        "scripts/lib/luna-front-desk-catalog-service.js"
      ]
    },
    "schedule": {
      "baseline_path": "service_addons.lesson_scheduling",
      "operations_path": "operations",
      "consumption_class": "legacy_consumed",
      "legacy_consumers": [
        "scripts/lib/tenant-business-config.js",
        "scripts/lib/staff-portal-clients.js"
      ]
    },
    "profile": {
      "baseline_path": "persona",
      "meta_path": "_meta",
      "consumption_class": "legacy_consumed",
      "legacy_consumers": [
        "scripts/lib/staff-portal-clients.js",
        "scripts/lib/tenant-business-config.js"
      ]
    },
    "features": {
      "portal_default_tab": "bed-calendar",
      "inventory_model": "lodging_rooms_beds",
      "hidden_tabs": [],
      "consumption_class": "factory_generator_only",
      "legacy_consumers": [],
      "note": "staff-portal-clients derives default_tab/hidden_tabs from _meta.vertical (surf vs lodging), not features.portal_default_tab / features.inventory_model / features.hidden_tabs. These fields are FACTORY generator guidance only."
    },
    "inventory": {
      "baseline_path": "rooming.rooms",
      "consumption_class": "legacy_consumed",
      "legacy_consumers": [
        "scripts/lib/staff-portal-clients.js"
      ]
    }
  },
  "consumer_categories": [
    "pricing_services_schedule_profile_consumers",
    "physical_site_keys",
    "registries"
  ],
  "legacy_compatibility": {
    "loads_via_existing_baseline_without_factory_migration": true,
    "factory_templates_are_not_runtime_loaded": true,
    "reference_pair_bytes_must_remain_unchanged": [
      "config/clients/wolfhouse-somo.baseline.json",
      "config/clients/wolfhouse-somo.pricing.json"
    ]
  }
}
