{
  "_meta": {
    "purpose": "FACTORY 1B surf_house pricing companion template. Shape mirrors wolfhouse-quote-calculator reads (add_ons, deposits.tiers, room_supplements, seasons.month_numbers+priority, packages.seasonal_prices, payment_options). rounding/hold are recognized companion metadata for canonical-file parity — not calculator-consumed. Placeholders only — not live prices.",
    "client_slug": "{{CLIENT_SLUG}}",
    "config_version": "1B.0",
    "status": "archetype_template",
    "pricing_status": "unverified_seed",
    "slice": "FACTORY-1B",
    "derived_from_consumer": "scripts/lib/wolfhouse-quote-calculator.js",
    "notes": [
      "Calculator-accessed fields: seasons.month_numbers (numeric 1–12), seasons.priority, packages.seasonal_prices.weekly_per_person_cents, room_supplements, add_ons, deposits.tiers, payment_options.",
      "rounding and hold are recognized companion metadata (canonical wolfhouse-somo.pricing.json parity) — not read by wolfhouse-quote-calculator today.",
      "month_numbers are unique numeric 1–12 with deterministic no-overlap, or explicit unique priority for overlaps (findSeason).",
      "Consumer-facing scalars are numbers or strict {{TOKEN}} placeholders — never objects/notes-only maps.",
      "Do not invent top-level addons or deposit keys — calculator reads add_ons and deposits.tiers."
    ]
  },
  "client_slug": "{{CLIENT_SLUG}}",
  "config_version": "1B.0",
  "currency": "{{CURRENCY}}",
  "seasons": [
    {
      "code": "{{SEASON_SHOULDER}}",
      "month_numbers": [1, 2],
      "priority": 0
    },
    {
      "code": "{{SEASON_HIGH}}",
      "month_numbers": [3],
      "priority": 0
    },
    {
      "code": "{{SEASON_PEAK}}",
      "month_numbers": [4],
      "priority": 10
    },
    {
      "code": "closed",
      "month_numbers": [5, 6],
      "bookable": false
    }
  ],
  "packages": [
    {
      "code": "{{PACKAGE_CODE_1}}",
      "name": "{{PACKAGE_NAME_1}}",
      "price_scope": "per_person_per_week",
      "base_room_type": "shared",
      "inclusions": ["{{INCLUSION_1}}"],
      "seasonal_prices": {
        "{{SEASON_SHOULDER}}": { "weekly_per_person_cents": "{{PRICE_CENTS_PLACEHOLDER}}" },
        "{{SEASON_HIGH}}": { "weekly_per_person_cents": "{{PRICE_CENTS_PLACEHOLDER}}" },
        "{{SEASON_PEAK}}": { "weekly_per_person_cents": "{{PRICE_CENTS_PLACEHOLDER}}" }
      },
      "pricing_status": "unverified_seed"
    },
    {
      "code": "{{PACKAGE_CODE_2}}",
      "name": "{{PACKAGE_NAME_2}}",
      "price_scope": "per_person_per_week",
      "base_room_type": "shared",
      "inclusions": ["{{INCLUSION_1}}", "{{INCLUSION_2}}"],
      "seasonal_prices": {
        "{{SEASON_SHOULDER}}": { "weekly_per_person_cents": "{{PRICE_CENTS_PLACEHOLDER}}" },
        "{{SEASON_HIGH}}": { "weekly_per_person_cents": "{{PRICE_CENTS_PLACEHOLDER}}" },
        "{{SEASON_PEAK}}": { "weekly_per_person_cents": "{{PRICE_CENTS_PLACEHOLDER}}" }
      },
      "pricing_status": "unverified_seed"
    },
    {
      "code": "{{PACKAGE_CODE_3}}",
      "name": "{{PACKAGE_NAME_3}}",
      "price_scope": "per_person_per_week",
      "base_room_type": "shared",
      "inclusions": ["{{INCLUSION_1}}", "{{INCLUSION_2}}", "{{INCLUSION_3}}"],
      "seasonal_prices": {
        "{{SEASON_SHOULDER}}": { "weekly_per_person_cents": "{{PRICE_CENTS_PLACEHOLDER}}" },
        "{{SEASON_HIGH}}": { "weekly_per_person_cents": "{{PRICE_CENTS_PLACEHOLDER}}" },
        "{{SEASON_PEAK}}": { "weekly_per_person_cents": "{{PRICE_CENTS_PLACEHOLDER}}" }
      },
      "pricing_status": "unverified_seed"
    }
  ],
  "room_supplements": {
    "shared": {
      "per_person_per_night_cents": "{{ROOM_SUPPLEMENT_SHARED_CENTS}}"
    },
    "double": {
      "per_room_per_night_cents": "{{ROOM_SUPPLEMENT_DOUBLE_CENTS}}",
      "per_person_per_night_cents": "{{ROOM_SUPPLEMENT_DOUBLE_PERSON_CENTS}}"
    },
    "private": {
      "per_room_per_night_cents": "{{ROOM_SUPPLEMENT_PRIVATE_CENTS}}",
      "per_person_per_night_cents": "{{ROOM_SUPPLEMENT_PRIVATE_PERSON_CENTS}}"
    }
  },
  "rounding": {
    "method": "ceil_to_nearest_5_eur",
    "nearest_cents": 500,
    "seven_night_rule": "For stays of exactly 7 nights, use the flat weekly_per_person_cents directly — no proration needed.",
    "formula_to_use": "{{PRORATION_FORMULA_PLACEHOLDER}}"
  },
  "deposits": {
    "rule_type": "tiered_by_booking_type",
    "scope": "per_booking",
    "tiers": {
      "standard_package": {
        "amount_cents": "{{DEPOSIT_STANDARD_CENTS}}"
      },
      "custom_or_short_stay": {
        "amount_cents": "{{DEPOSIT_SHORT_CENTS}}"
      }
    },
    "default_cents": "{{DEPOSIT_DEFAULT_CENTS}}"
  },
  "hold": {
    "expiry_minutes": "{{HOLD_EXPIRY_MINUTES}}",
    "status": "unverified_seed"
  },
  "payment_options": ["deposit", "full", "pay_on_arrival"],
