FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV CROWSNEST_PORT=3040
ENV CROWSNEST_HOST=0.0.0.0

COPY package*.json ./
RUN npm ci --omit=dev

COPY scripts ./scripts
COPY config/staff-portal/staff-login-page.css ./config/staff-portal/staff-login-page.css
COPY public/crowsnest ./public/crowsnest
COPY public/images/luna-login-bg.jpg ./public/images/luna-login-bg.jpg

# Supplied by the approved release owner for this exact directory artifact.
# Persist in the image, not overridable runtime ENV; omitted inputs stay unavailable.
ARG CROWSNEST_BUILD_SHA
ARG CROWSNEST_BUILT_AT
RUN node -e "require('fs').writeFileSync('crowsnest-build.json', JSON.stringify({sha: process.env.CROWSNEST_BUILD_SHA || '', built_at: process.env.CROWSNEST_BUILT_AT || ''}), {mode: 0o444})"

EXPOSE 3040

CMD ["node", "scripts/crowsnest-api.js"]
