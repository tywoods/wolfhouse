# Host-owned mode-0600 files: /etc/wolfhouse-prod/{postgres,staff-api,staff-meta,luna}.env
# staff-api.env public routing (not secrets):
#   LUNA_DEPLOYMENT=production
#   WOLFHOUSE_HERMES_BASE_URL=http://luna:8090
#   CROWSNEST_LIVE_SIM_WOLFHOUSE_ORIGIN=http://luna:8090
# Do not point those URLs at TEST Luna (hermes-luna).
# WA_ACCESS_TOKEN stays a non-Graph placeholder until Ty mints a prod System User token.
# App secret + verify token come from staff-meta.env (META_APP_SECRET, META_WHATSAPP_VERIFY_TOKEN).
# Required public identity in luna.env (not a secret):
# WA_PHONE_NUMBER_ID=1383127691556412
# Keep WHATSAPP_DRY_RUN=true and LUNA_AUTO_SEND_ENABLED=false. This identity is
# required for Hermes to validate the selected WA_* profile and bind the private
# internal simulator; it does not authorize a webhook, public port, or outbound.
# Stripe must be TEST. WhatsApp webhook/number changes are excluded.
