# France controller public identity. Placeholders only.
# Do not put token or app-secret assignments in this file.
# Luna and Staff load those from the operator env file /root/wa-luna-ar.env.
LUNA_ROUTING_CONTROLLER_PORT=8096
LUNA_ROUTING_SITE=whatsapp-staging.lunafrontdesk.com
LUNA_ROUTING_MUTATIONS_ENABLED=false
LUNA_ROUTING_CONTROLLER_HMAC_KEY=replace-with-at-least-32-bytes
LUNA_ROUTING_INGRESS_PROOF_KEY=replace-with-at-least-32-bytes
LUNA_ROUTING_INGRESS_PROOF_URL=https://staging.example.invalid/proof
WA_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
WA_BUSINESS_ACCOUNT_ID=REPLACE_WITH_WABA_ID
WA_APP_ID=REPLACE_WITH_APP_ID
