{
  "apps": {
    "http": {
      "servers": {
        "one": {
          "routes": [
            {
              "match": [{"host": ["whatsapp-staging.lunafrontdesk.com"]}],
              "terminal": true,
              "handle": [{
                "handler": "subroute",
                "routes": [
                  {
                    "match": [{"path": ["/_internal/luna-routing/v1/routes/meta-whatsapp-verified-webhook"]}],
                    "handle": [
                      {"handler": "rewrite", "uri": "/v1/routes/meta-whatsapp-verified-webhook"},
                      {"handler": "reverse_proxy", "upstreams": [{"dial": "127.0.0.1:8096"}]}
                    ]
                  },
                  {
                    "match": [{"path": ["/whatsapp/routing-proof"]}],
                    "handle": [{"handler": "subroute", "routes": [{"handle": [{"handler": "reverse_proxy", "upstreams": [{"dial": "127.0.0.1:8094"}]}]}]}]
                  }
                ]
              }]
            }
          ]
        },
        "main": {
          "listen": [":443"],
          "protocols": ["h1", "h2"],
          "automatic_https": {"disable": false},
          "routes": [{"match": [{"host": ["protected.example.com"]}], "terminal": true, "handle": [{"handler": "static_response", "status_code": 204}]}]
        }
      }
    },
    "tls": {"automation": {"policies": [{"subjects": ["protected.example.com"]}]}},
    "logging": {"logs": {"default": {"level": "INFO"}}}
  }
}
