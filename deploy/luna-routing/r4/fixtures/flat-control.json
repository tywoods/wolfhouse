{
  "apps": {
    "http": {
      "servers": {
        "one": {
          "routes": [
            {
              "match": [{"host": ["whatsapp-staging.lunafrontdesk.com"], "path": ["/_internal/luna-routing/v1/routes/meta-whatsapp-verified-webhook"]}],
              "handle": [
                {"handler": "rewrite", "uri": "/v1/routes/meta-whatsapp-verified-webhook"},
                {"handler": "reverse_proxy", "upstreams": [{"dial": "localhost:8096"}]}
              ]
            },
            {
              "match": [{"host": ["whatsapp-staging.lunafrontdesk.com"], "path": ["/whatsapp/routing-proof"]}],
              "handle": [{"handler": "reverse_proxy", "upstreams": [{"dial": "127.0.0.1:8094"}]}]
            }
          ]
        }
      }
    }
  }
}
