{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunafrontdesk.com/contracts/luna-v3/check-quote-book.json",
  "title": "Luna v3 public one-try booking transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action"
  ],
  "x-staff-public-catalog": {
    "accommodation_only": {
      "item_type": "package",
      "item_code": "package_none",
      "label": "Accommodation only",
      "description": "Accommodation without a surf package.",
      "requirements": {
        "package_minimum_nights": false,
        "exact_bed_required": false,
        "bed_allocation": "staff_allocates_unless_explicit",
        "guest_count_required": true
      },
      "metadata": {
        "includes": []
      }
    }
  },
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "prepare",
        "confirm",
        "decline"
      ]
    },
    "purpose": {
      "type": "string",
      "enum": [
        "quote",
        "offer"
      ]
    },
    "check_in": {
      "type": "string",
      "format": "date"
    },
    "check_out": {
      "type": "string",
      "format": "date"
    },
    "guests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "explicit_gender": {
            "type": "string",
            "minLength": 1
          },
          "gender": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "exact",
            "private",
            "shared",
            "women_only",
            "auto"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "beds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "together": {
          "type": "string",
          "enum": [
            "required",
            "preferred",
            "not_required"
          ]
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "per_guest": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "guest"
            ],
            "properties": {
              "guest": {
                "type": "integer",
                "minimum": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "anyOf": [
              {
                "required": [
                  "code"
                ]
              },
              {
                "required": [
                  "name"
                ]
              }
            ]
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "code"
          ]
        },
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "per_guest"
          ]
        }
      ]
    },
    "add_ons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "description": "Number of people or equipment units; never participant-days. Invalid guest-supplied values are forwarded so Staff can return the authoritative refusal."
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of distinct requested dates."
          },
          "people": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "dates": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date"
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Exact selected dates. A service with multiple dates is refused until Staff has an explicit count interpretation."
          },
          "requested_dates": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "anyOf": [
          {
            "required": [
              "code"
            ]
          },
          {
            "required": [
              "name"
            ]
          }
        ]
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arrangement"
      ],
      "properties": {
        "arrangement": {
          "type": "string",
          "enum": [
            "together",
            "separately"
          ]
        },
        "choice": {
          "type": "string",
          "enum": [
            "deposit",
            "balance"
          ]
        }
      }
    },
    "offer_reference": {
      "type": "string",
      "pattern": "^offer_[A-Za-z0-9_-]{24,80}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "prepare"
          },
          "purpose": {
            "const": "quote"
          }
        },
        "required": [
          "action",
          "purpose"
        ]
      },
      "then": {
        "required": [
          "check_in",
          "check_out",
          "guests",
          "room",
          "package",
          "add_ons"
        ],
        "not": {
          "required": [
            "payment"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "prepare"
          },
          "purpose": {
            "const": "offer"
          }
        },
        "required": [
          "action",
          "purpose"
        ]
      },
      "then": {
        "required": [
          "check_in",
          "check_out",
          "guests",
          "room",
          "package",
          "add_ons",
          "payment"
        ],
        "properties": {
          "guests": {
            "items": {
              "required": [
                "name"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "confirm",
              "decline"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "offer_reference"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "purpose"
              ]
            },
            {
              "required": [
                "check_in"
              ]
            },
            {
              "required": [
                "check_out"
              ]
            },
            {
              "required": [
                "guests"
              ]
            },
            {
              "required": [
                "room"
              ]
            },
            {
              "required": [
                "package"
              ]
            },
            {
              "required": [
                "add_ons"
              ]
            },
            {
              "required": [
                "payment"
              ]
            }
          ]
        }
      }
    }
  ]
}
