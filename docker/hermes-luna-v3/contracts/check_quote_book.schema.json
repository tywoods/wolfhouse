{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunafrontdesk.com/contracts/luna-v3/check-quote-book.json",
  "title": "Luna v3 public one-try booking transaction",
  "type": "object",
  "additionalProperties": false,
  "required": ["action"],
  "properties": {
    "action": {"enum": ["prepare", "confirm", "decline"]},
    "purpose": {"enum": ["offer", "information"]},
    "check_in": {"type": "string", "format": "date"},
    "check_out": {"type": "string", "format": "date"},
    "guests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name"],
        "properties": {"name": {"type": "string", "minLength": 1}, "explicit_gender": {"type": "string", "minLength": 1}, "gender": {"type": "string", "minLength": 1}}
      }
    },
    "room": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": {"enum": ["exact", "private", "shared", "women_only", "auto"]},
        "name": {"type": "string", "minLength": 1},
        "beds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "together": {"enum": ["required", "preferred", "not_required"]}
      }
    },
    "package": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "per_guest": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["guest", "name"],
            "properties": {"guest": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1}}
          }
        }
      }, "anyOf": [{"required": ["name"]}, {"required": ["per_guest"]}]
    },
    "add_ons": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "properties": {
   "name": {"type": "string", "minLength": 1},
   "code": {"type": "string", "minLength": 1},
   "quantity": {"type": "integer", "minimum": 1},
   "days": {"type": "integer", "minimum": 1},
   "people": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
   "dates": {"type": "array", "items": {"type": "string", "format": "date"}, "uniqueItems": true},
   "requested_dates": {"type": "array", "items": {"type": "string", "format": "date"}, "uniqueItems": true}
 },
 "anyOf": [{"required": ["code"]}, {"required": ["name"]}]
      }
    },
    "payment": {
      "type": "object", "additionalProperties": false, "required": ["arrangement"],
      "properties": {"arrangement": {"enum": ["together", "separately"]}, "choice": {"enum": ["deposit", "balance"]}}
    },
    "offer_reference": {"type": "string", "pattern": "^offer_[A-Za-z0-9_-]{24,80}$"}
  },
  "allOf": [
    {"if": {"properties": {"action": {"const": "prepare"}, "purpose": {"const": "offer"}}, "required": ["action", "purpose"]}, "then": {"required": ["check_in", "check_out", "guests", "room", "package", "add_ons", "payment"]}},
    {"if": {"properties": {"action": {"const": "prepare"}, "purpose": {"const": "information"}}, "required": ["action", "purpose"]}, "then": {"required": ["check_in", "check_out"]}},
    {"if": {"properties": {"action": {"enum": ["confirm", "decline"]}}, "required": ["action"]}, "then": {"required": ["offer_reference"]}}
  ]
}
