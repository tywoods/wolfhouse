# MAIL-MVP-007 — separately deployable Sunset email Sol runtime.
# Colocated with Staff API in luna-sunset-staging-env. Internal TLS ingress.
# Do not apply infra/azure Bicep. Fill only values Skipper can query
# (subscription ID, environment resource ID, identity resource ID, image SHA).
# Never commit secrets. Never leave angle-bracket placeholders in the applied YAML.
#
# Keep image ENTRYPOINT (/init). Args replace CMD only so bootstrap still runs.
# Production interpreter is exactly /opt/hermes/.venv/bin/python.
#
# Isolated openai-codex auth.json lives on a dedicated Azure Files share
# mounted at /opt/data (entire isolated HERMES_HOME). No Key Vault auth-json
# snapshot. No shared WhatsApp pool. API bearer + response HMAC remain
# Key Vault / ACA secrets.
#
# Skipper: docs/MAIL-MVP-007-SUNSET-EMAIL-SOL-RUNBOOK.md fills a temp copy
# then: az containerapp create|update -g luna-sunset-staging-rg -n luna-sunset-staging-email-luna --yaml FILLED.yaml
# Do not pass --environment with --yaml (ignored; environmentId comes from YAML).
apiVersion: '2024-03-01'
location: northeurope
name: luna-sunset-staging-email-luna
type: Microsoft.App/containerApps
identity:
  type: UserAssigned
  userAssignedIdentities:
    <identity-id>: {}
properties:
  environmentId: <environment-id>
  configuration:
    secrets:
      - name: api-server-key
        keyVaultUrl: https://luna-sunset-staging-kv.vault.azure.net/secrets/email-luna-hermes-sol-token
        identity: <identity-id>
      - name: resp-hmac-secret
        keyVaultUrl: https://luna-sunset-staging-kv.vault.azure.net/secrets/email-luna-hermes-sol-hmac
        identity: <identity-id>
    registries:
      - server: whstagingacr.azurecr.io
        identity: <identity-id>
    ingress:
      external: false
      allowInsecure: false
      targetPort: 8093
      transport: http
      traffic:
        - latestRevision: true
          weight: 100
  template:
    containers:
      - name: hermes-sunset-email-luna
        image: whstagingacr.azurecr.io/wh-hermes-staging:<full-master-sha>
        args:
          - /opt/hermes/.venv/bin/python
          - /etc/hermes-staging/wolfhouse/email_draft_server.py
        volumeMounts:
          - volumeName: hermes-home
            mountPath: /opt/data
        env:
          - name: HERMES_HOME
            value: /opt/data
          - name: HERMES_ROLE
            value: sunset-email-luna
          - name: LUNA_TENANT_ID
            value: sunset
          - name: LUNA_CLIENT_SLUG
            value: sunset
          - name: LUNA_ALLOWED_LOCATION_IDS
            value: sunset-somo
          - name: EMAIL_LUNA_DRAFT_LISTEN_HOST
            value: 0.0.0.0
          - name: EMAIL_LUNA_DRAFT_LISTEN_PORT
            value: '8093'
          - name: PYTHONPATH
            value: /etc/hermes-staging
          - name: GENERIC_TIMEZONE
            value: Europe/Madrid
          - name: API_SERVER_KEY
            secretRef: api-server-key
          - name: EMAIL_LUNA_HERMES_SOL_RESPONSE_HMAC_SECRET
            secretRef: resp-hmac-secret
        probes:
          - type: Liveness
            httpGet:
              path: /healthz
              port: 8093
            initialDelaySeconds: 10
            periodSeconds: 20
          - type: Readiness
            httpGet:
              path: /healthz
              port: 8093
            initialDelaySeconds: 5
            periodSeconds: 10
        resources:
          cpu: 1.0
          memory: 2Gi
    volumes:
      - name: hermes-home
        storageType: AzureFile
        storageName: hermes-sunset-email-luna-home
        mountOptions: uid=10000,gid=10000,nobrl,mfsymlinks,dir_mode=0700,file_mode=0600
    scale:
      minReplicas: 1
      maxReplicas: 1
