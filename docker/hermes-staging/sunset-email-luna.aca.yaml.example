# MAIL-MVP-007 — separately deployable Sunset email Sol runtime.
# Colocated with Staff API in luna-sunset-staging-env. Internal TLS ingress.
# Do not apply infra/azure Bicep. Fill only values Skipper can query
# (subscription ID, identity/env resource IDs, image SHA). Never commit secrets.
#
# Keep image ENTRYPOINT (/init). Args replace CMD only so bootstrap still runs.
# Production interpreter is exactly /opt/hermes/.venv/bin/python.
#
# Isolated openai-codex auth.json is a Key Vault secret (base64), written
# atomically to /opt/data/auth.json by bootstrap (0600). No Azure Files,
# no shared volume, no persistence back to WhatsApp.
#
# Skipper: docs/MAIL-MVP-007-SUNSET-EMAIL-SOL-RUNBOOK.md emits a filled copy
# then: az containerapp create -g luna-sunset-staging-rg -n luna-sunset-staging-email-luna --yaml <filled>
apiVersion: '2024-03-01'
location: northeurope
identity:
  type: UserAssigned
  userAssignedIdentities:
    /subscriptions/<subscription-id>/resourceGroups/luna-sunset-staging-rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/luna-sunset-staging-identity: {}
properties:
  managedEnvironmentId: /subscriptions/<subscription-id>/resourceGroups/luna-sunset-staging-rg/providers/Microsoft.App/managedEnvironments/luna-sunset-staging-env
  configuration:
    secrets:
      - name: api-server-key
        keyVaultUrl: https://luna-sunset-staging-kv.vault.azure.net/secrets/email-luna-hermes-sol-token
        identity: /subscriptions/<subscription-id>/resourceGroups/luna-sunset-staging-rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/luna-sunset-staging-identity
      - name: hermes-sunset-email-auth-json-b64
        keyVaultUrl: https://luna-sunset-staging-kv.vault.azure.net/secrets/hermes-sunset-email-luna-auth-json-b64
        identity: /subscriptions/<subscription-id>/resourceGroups/luna-sunset-staging-rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/luna-sunset-staging-identity
    registries:
      - server: whstagingacr.azurecr.io
        identity: /subscriptions/<subscription-id>/resourceGroups/luna-sunset-staging-rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/luna-sunset-staging-identity
    ingress:
      external: false
      allowInsecure: false
      targetPort: 8093
      transport: http
      traffic:
        - latestRevision: true
          weight: 100
  template:
    containers:
      - name: hermes-sunset-email-luna
        image: whstagingacr.azurecr.io/wh-hermes-staging:<full-master-sha>
        args:
          - /opt/hermes/.venv/bin/python
          - /etc/hermes-staging/wolfhouse/email_draft_server.py
        env:
          - name: HERMES_HOME
            value: /opt/data
          - name: HERMES_ROLE
            value: sunset-email-luna
          - name: LUNA_TENANT_ID
            value: sunset
          - name: LUNA_CLIENT_SLUG
            value: sunset
          - name: LUNA_ALLOWED_LOCATION_IDS
            value: sunset-somo
          - name: EMAIL_LUNA_DRAFT_LISTEN_HOST
            value: 0.0.0.0
          - name: EMAIL_LUNA_DRAFT_LISTEN_PORT
            value: '8093'
          - name: PYTHONPATH
            value: /etc/hermes-staging
          - name: GENERIC_TIMEZONE
            value: Europe/Madrid
          - name: API_SERVER_KEY
            secretRef: api-server-key
          - name: HERMES_SUNSET_EMAIL_AUTH_JSON_B64
            secretRef: hermes-sunset-email-auth-json-b64
        probes:
          - type: Liveness
            httpGet:
              path: /healthz
              port: 8093
            initialDelaySeconds: 10
            periodSeconds: 20
          - type: Readiness
            httpGet:
              path: /healthz
              port: 8093
            initialDelaySeconds: 5
            periodSeconds: 10
        resources:
          cpu: 1.0
          memory: 2Gi
    scale:
      minReplicas: 1
      maxReplicas: 1
